generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Profil étudiant ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills          UserSkill[]
  availabilities  Availability[]
  matchesAsSeeker Match[]        @relation("seeker")
  matchesAsHelper Match[]        @relation("helper")
  sessionsParts   SessionParticipant[]
  points          Point[]
  badges          UserBadge[]
  challengesSent  Challenge[]    @relation("challenger")
  challengesRecv  Challenge[]    @relation("challenged")
  feedPosts       FeedPost[]
  recommendations Recommendation[] @relation("recommender")
  recommendationsRecv Recommendation[] @relation("recommended")
  feedbacks       Feedback[]     @relation("feedbackGiver")
  feedbacksRecv   Feedback[]     @relation("feedbackReceiver")
}

model Skill {
  id       String      @id @default(cuid())
  name     String      @unique
  category String

  userSkills UserSkill[]
  matches    Match[]
  sessions   Session[]
}

enum SkillType {
  LEARNING
  TEACHING
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

model UserSkill {
  id      String     @id @default(cuid())
  userId  String
  skillId String
  type    SkillType
  level   SkillLevel

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0 = dimanche … 6 = samedi
  startTime String   // ex : "09:00"
  endTime   String   // ex : "12:00"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Matching ────────────────────────────────────────────────────────────────

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Match {
  id        String      @id @default(cuid())
  seekerId  String
  helperId  String
  skillId   String
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())

  seeker User  @relation("seeker", fields: [seekerId], references: [id])
  helper User  @relation("helper", fields: [helperId], references: [id])
  skill  Skill @relation(fields: [skillId], references: [id])
}

// ─── Sessions ────────────────────────────────────────────────────────────────

enum SessionType {
  WORKSHOP
  QUICK_COURSE
  CLUB
}

enum SessionStatus {
  PLANNED
  ONGOING
  DONE
  CANCELLED
}

model Session {
  id          String        @id @default(cuid())
  title       String
  type        SessionType
  status      SessionStatus @default(PLANNED)
  skillId     String?
  scheduledAt DateTime
  durationMin Int
  createdAt   DateTime      @default(now())

  skill        Skill?               @relation(fields: [skillId], references: [id])
  participants SessionParticipant[]
  feedbacks    Feedback[]
}

model SessionParticipant {
  sessionId String
  userId    String

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
}

// ─── Gamification ────────────────────────────────────────────────────────────

model Point {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String @id @default(cuid())
  name        String @unique
  description String
  iconUrl     String?

  users UserBadge[]
}

model UserBadge {
  userId      String
  badgeId     String
  unlockedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  COMPLETED
  DECLINED
}

model Challenge {
  id           String          @id @default(cuid())
  challengerId String
  challengedId String
  description  String
  status       ChallengeStatus @default(OPEN)
  createdAt    DateTime        @default(now())

  challenger User @relation("challenger", fields: [challengerId], references: [id])
  challenged User @relation("challenged", fields: [challengedId], references: [id])
}

// ─── Feed social ─────────────────────────────────────────────────────────────

model FeedPost {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id              String   @id @default(cuid())
  recommenderId   String
  recommendedId   String
  content         String
  createdAt       DateTime @default(now())

  recommender User @relation("recommender", fields: [recommenderId], references: [id])
  recommended User @relation("recommended", fields: [recommendedId], references: [id])
}

model Feedback {
  id         String   @id @default(cuid())
  giverId    String
  receiverId String
  sessionId  String?
  rating     Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  giver    User     @relation("feedbackGiver", fields: [giverId], references: [id])
  receiver User     @relation("feedbackReceiver", fields: [receiverId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])
}
