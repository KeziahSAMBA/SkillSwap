// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillType {
  TEACH
  LEARN
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SessionType {
  WORKSHOP
  QUICK_COURSE
  CLUB
}

enum SessionStatus {
  PLANNED
  ONGOING
  DONE
  CANCELLED
}

enum ChallengeStatus {
  OPEN
  ACCEPTED
  COMPLETED
  DECLINED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills              UserSkill[]
  availabilities      Availability[]
  matchesAsSeeker     Match[]              @relation("seeker")
  matchesAsHelper     Match[]              @relation("helper")
  sessionsParts       SessionParticipant[]
  points              Point[]
  badges              UserBadge[]
  challengesSent      Challenge[]          @relation("challenger")
  challengesRecv      Challenge[]          @relation("challenged")
  feedPosts           FeedPost[]
  recommendations     Recommendation[]     @relation("recommender")
  recommendationsRecv Recommendation[]     @relation("recommended")
  feedbacks           Feedback[]           @relation("giver")
  feedbacksRecv       Feedback[]           @relation("receiver")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String?
  userSkills UserSkill[]
  matches    Match[]
  sessions   Session[]
}

model UserSkill {
  id      String     @id @default(uuid())
  user    User       @relation(fields: [userId], references: [id])
  userId  String
  skill   Skill      @relation(fields: [skillId], references: [id])
  skillId String
  level   SkillLevel
  type    SkillType

  @@unique([userId, skillId, type])
}

model Availability {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  dayOfWeek Int
  startTime String
  endTime   String
}

model Match {
  id        String      @id @default(uuid())
  seeker    User        @relation("seeker", fields: [seekerId], references: [id])
  seekerId  String
  helper    User        @relation("helper", fields: [helperId], references: [id])
  helperId  String
  skill     Skill       @relation(fields: [skillId], references: [id])
  skillId   String
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model Session {
  id           String               @id @default(uuid())
  title        String
  type         SessionType
  status       SessionStatus        @default(PLANNED)
  scheduledAt  DateTime
  skill        Skill                @relation(fields: [skillId], references: [id])
  skillId      String
  participants SessionParticipant[]
  feedbacks    Feedback[]
  createdAt    DateTime             @default(now())
}

model SessionParticipant {
  id        String  @id @default(uuid())
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String
  user      User    @relation(fields: [userId], references: [id])
  userId    String
}

model Point {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  amount      Int
  description String?
  createdAt   DateTime @default(now())
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?
  iconUrl     String?
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  badgeId   String
  earnedAt  DateTime @default(now())
}

model Challenge {
  id           String          @id @default(uuid())
  challenger   User            @relation("challenger", fields: [challengerId], references: [id])
  challengerId String
  challenged   User            @relation("challenged", fields: [challengedId], references: [id])
  challengedId String
  description  String
  status       ChallengeStatus @default(OPEN)
  createdAt    DateTime        @default(now())
}

model FeedPost {
  id        String   @id @default(uuid())
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())
}

model Recommendation {
  id            String   @id @default(uuid())
  recommender   User     @relation("recommender", fields: [recommenderId], references: [id])
  recommenderId String
  recommended   User     @relation("recommended", fields: [recommendedId], references: [id])
  recommendedId String
  content       String
  createdAt     DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  giver     User     @relation("giver", fields: [giverId], references: [id])
  giverId   String
  receiver  User     @relation("receiver", fields: [receiverId], references: [id])
  receiverId String
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}
